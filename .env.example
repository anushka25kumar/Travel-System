# ===================================================================
# TravelSmart - Environment Configuration Template
# Copy this file to .env or export these variables into your shell
# ===================================================================

# Server Port
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travelsmart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# -------------------------------------------------------------------
# Flight Provider API: Amadeus Flight Offers Search v2
# Register at: https://developers.amadeus.com/
# -------------------------------------------------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
# When empty or invalid, TravelSmart automatically operates in DEMO / TIMETABLE mode
# with explicit data source badges, preserving full platform availability.

# -------------------------------------------------------------------
# Train Provider API: Indian Railways / IRCTC Authorized Gateway
# -------------------------------------------------------------------
TRAIN_API_BASE_URL=
TRAIN_API_KEY=
# Note: Direct scraping of irctc.co.in is strictly prohibited.
# When uncredentialed, verified IRCTC schedules & timetables are served
# with "Live availability unavailable" status tags.

# -------------------------------------------------------------------
# Bus Provider API: redBus / Authorized Bus Aggregator
# -------------------------------------------------------------------
BUS_API_BASE_URL=
BUS_API_KEY=
# When uncredentialed, verified intercity bus timetables (Shivneri, IntrCity, Zingbus)
# are served with clear DEMO / CACHED indicators.
